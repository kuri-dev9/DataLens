DATALENS_HTTP_HOST=0.0.0.0
DATALENS_HTTP_PORT=8000
DATALENS_BIND_HOST=127.0.0.1
DATALENS_BIND_PORT=20005
DATALENS_IMAGE=datalens:0.1.0
QUERYFORGE_IMAGE=queryforge:local
QUERYFORGE_CONTEXT=../QueryForge
QUERYFORGE_BIND_HOST=127.0.0.1
QUERYFORGE_BIND_PORT=20001
DATALENS_LOG_LEVEL=info
DATALENS_REQUEST_DEADLINE_SECONDS=300
DATALENS_SESSION_TTL_SECONDS=1800
DATALENS_COUNTRY=KR
DATALENS_AGENT_MAX_TOOL_CALLS=12
DATALENS_AGENT_RECOVERY_BUDGET=5
DATALENS_AGENT_PREVIEW_ROWS=20
DATALENS_LLM_PROVIDER=ollama
DATALENS_OLLAMA_BASE_URL=http://127.0.0.1:11434
DATALENS_OLLAMA_MODEL=gemma4:26b
DATALENS_OLLAMA_REQUEST_TIMEOUT_SECONDS=120
DATALENS_OLLAMA_NUM_CTX=16384
DATALENS_OLLAMA_TEMPERATURE=0.2
DATALENS_OLLAMA_TOP_P=0.95
DATALENS_OLLAMA_TOP_K=64
DATALENS_ENABLE_THINKING=false
DATALENS_MEMORY_ENABLED=true
DATALENS_MEMORY_PATH=/var/lib/datalens/memory.sqlite3
DATALENS_EMBEDDING_MODEL=bge-m3
# 비워두면 DATALENS_OLLAMA_BASE_URL을 재사용한다. CPU 전용 임베딩 서버를 띄웠다면 그 주소.
DATALENS_EMBEDDING_BASE_URL=
DATALENS_EMBEDDING_API=ollama
DATALENS_MEMORY_RECIPE_LIMIT=3
DATALENS_MEMORY_TERM_LIMIT=5
DATALENS_MEMORY_THRESHOLD=0.55
DATALENS_MEMORY_MAX_RECIPES=500
DATALENS_CORS_ORIGINS=*
# 호스트에서 DataLens 를 직접 돌릴 때의 주소(QUERYFORGE_BIND_PORT). compose 로 함께 띄우면
# 컨테이너 안 주소 http://pp-queryforge:8080/mcp 를 쓴다(컨테이너 포트는 8080 그대로).
DATALENS_QUERYFORGE_ENDPOINT=http://127.0.0.1:20001/mcp
DATALENS_QUERYFORGE_DATA_BASE_URL=http://127.0.0.1:20001
# MCP 초기화·도구 목록·ready 전용. 장애 감지를 늦추지 않도록 짧게 둔다.
DATALENS_QUERYFORGE_TIMEOUT_SECONDS=5
# 실제 도구 호출과 Data API 상한. QueryForge의 query/transform 상한(각 60초)을 덮어야 한다.
DATALENS_QUERYFORGE_CALL_TIMEOUT_SECONDS=70
DATALENS_QUERYFORGE_API_KEY=replace-with-queryforge-api-key
DATALENS_API_KEY=replace-with-datalens-api-key

# ── QueryForge 가 조회하는 DB 비밀번호 ─────────────────────────────────
#
# **이 파일이 비밀의 유일한 자리다** (2026-10-20). compose 의 `env_file` 이
# 이것을 **queryforge·datalens 둘 다**에 주고, QueryForge 쪽
# `config/databases.yaml` 은 값을 담지 않고 `password_ref:` 로 **변수 이름만**
# 가리킨다. 전에는 그 파일에 평문이 있었고, 비밀이 두 군데로 갈려 있으면
# 한쪽만 고쳤을 때 **에러 없이** DataLens 경유 질의만 실패한다.
#
# 이름 규칙은 `<databases.yaml 의 name 대문자>_PASSWORD` 다. DB 를 추가하면
# 그 규칙으로 변수를 하나 더 만든다 — 추론할 수 있어야 다음 사람이 찾는다.
#
#     databases.yaml:   - name: pemdb6
#                         password_ref: PEMDB6_PASSWORD
#     이 파일:          PEMDB6_PASSWORD=<값>
#
# ⚠ **변수를 추가·변경하면 컨테이너를 다시 만들어야 한다.** `password_ref` 는
#   기동 시점의 환경을 읽는다(`docs/ADR.md`) — `restart` 만으로는 반영되지
#   않을 수 있다. `./dl.sh restart queryforge` 가 `up -d --build` 라 재생성한다.
#
# 아래는 예시 이름이다. 실제 이름은 `databases.yaml` 의 `password_ref` 와
# 글자 그대로 같아야 한다 — 다르면 기동이 `missing ...` 으로 죽는다.
